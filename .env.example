APP_NAME="Blood Lagbe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=blood_lagbe
DB_USERNAME=postgres
DB_PASSWORD=

# For Render: Use DATABASE_URL instead (auto-set by Render PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@bloodlagbe.com"
MAIL_FROM_NAME="Blood Lagbe"

# Render (production) overrides:
# APP_ENV=production
# APP_DEBUG=false
# APP_KEY=  (auto-generated by render.yaml)
# DATABASE_URL=  (auto-set from Render PostgreSQL)
# LOG_CHANNEL=stderr
# MAIL_MAILER=smtp  (configure if you want real email)
